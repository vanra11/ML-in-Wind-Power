import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from sklearn.svm import SVR
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout

df = pd.read_csv('/content/DataWind2021.csv')  # Update with your local path


df['Power_Output'] = df['WindSpeed'] * 100 


if df.isnull().values.any():
    print("Warning: The dataset contains NaN values. Filling NaNs with forward fill method.")
    df.fillna(method='ffill', inplace=True)  


def create_dataset(X):
    X_lstm = []
    for i in range(len(X) - time_steps):
        X_lstm.append(X[i:(i + time_steps)])
    return np.array(X_lstm)

time_steps = 3  
X = df[['WindSpeed']].values
y = df['Power_Output'].values

X_lstm = create_dataset(X)
y_lstm = y[time_steps:]

X_train_lstm, X_test_lstm = train_test_split(X_lstm.reshape(-1, time_steps), test_size=0.2)
y_train_lstm = y_lstm[:len(X_train_lstm)]
y_test_lstm = y_lstm[len(X_train_lstm):]

X_train_lstm = X_train_lstm.reshape((X_train_lstm.shape[0], time_steps, 1))
X_test_lstm = X_test_lstm.reshape((X_test_lstm.shape[0], time_steps, 1))

lstm_model = Sequential()
lstm_model.add(LSTM(50, activation='relu', input_shape=(time_steps, 1)))
lstm_model.add(Dropout(0.2))
lstm_model.add(Dense(1))
lstm_model.compile(optimizer='adam', loss='mse')

lstm_model.fit(X_train_lstm, y_train_lstm, epochs=150)

y_pred_lstm = lstm_model.predict(X_test_lstm)

X_ensemble = df[['WindSpeed']].values[:-time_steps]  # Wind speed data for SVM
y_ensemble = df['Power_Output'].values[:-time_steps]


X_train_svm, X_test_svm, y_train_svm, y_test_svm = train_test_split(X_ensemble, y_ensemble, test_size=0.2)

svm_model = SVR(kernel='rbf')
svm_model.fit(X_train_svm, y_train_svm)

y_pred_svm = svm_model.predict(X_test_svm)
combined_predictions = (y_pred_lstm.flatten() + y_pred_svm) / 2

def evaluate_model(y_true, y_pred):
    if np.isnan(y_true).any() or np.isnan(y_pred).any():
        print("Warning: Predictions or true labels contain NaN values. Evaluation may not be accurate.")
        return None, None, None, None

    mse = mean_squared_error(y_true[-len(y_pred):], y_pred)
    mae = mean_absolute_error(y_true[-len(y_pred):], y_pred)
    rmse = np.sqrt(mse)
    r2 = r2_score(y_true[-len(y_pred):], y_pred)

    return mse, mae, rmse, r2

mse_lstm, mae_lstm, rmse_lstm, r2_lstm = evaluate_model(y_test_svm, y_pred_lstm)
mse_svm, mae_svm, rmse_svm, r2_svm = evaluate_model(y_test_svm, y_pred_svm)
mse_combined, mae_combined, rmse_combined, r2_combined = evaluate_model(y_test_svm, combined_predictions)


print(f'Combined Mean Squared Error (MSE): {mse_combined}')
print(f'Combined Mean Absolute Error (MAE): {mae_combined}')
print(f'Combined Root Mean Squared Error (RMSE): {rmse_combined}')
print(f'Combined R² Score: {r2_combined}')

plt.scatter(df['WindSpeed'], df['Power_Output'], color='blue', label='Actual')
plt.scatter(df['WindSpeed'][-len(combined_predictions):], combined_predictions.flatten(), color='red', label='Combined Predicted')
plt.xlabel('Wind Speed')
plt.ylabel('Power Output')
plt.title('LSTM + SVM Model: Wind Speed vs Power Output')
plt.legend()
plt.show()
