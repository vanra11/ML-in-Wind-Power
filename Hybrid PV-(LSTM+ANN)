import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout

df = pd.read_csv('/content/DataWind2021.csv')  

# Data Preparation: Extract Wind Speed and Power Output (assuming Power Output needs to be calculated)
df['Power_Output'] = df['WindSpeed'] * 100  

if df.isnull().values.any():
    print("Warning: The dataset contains NaN values. Filling NaNs with forward fill method.")
    df.fillna(method='ffill', inplace=True)  

def create_dataset(X):
    X_lstm = []
    for i in range(len(X) - time_steps):
        X_lstm.append(X[i:(i + time_steps)])
    return np.array(X_lstm)

time_steps = 3 
X = df[['WindSpeed']].values
y = df['Power_Output'].values

X_lstm = create_dataset(X)
y_lstm = y[time_steps:]

X_train, X_test = train_test_split(X_lstm.reshape(-1, time_steps), test_size=0.2)
y_train = y_lstm[:len(X_train)]
y_test = y_lstm[len(X_train):]

X_train = X_train.reshape((X_train.shape[0], time_steps, 1))
X_test = X_test.reshape((X_test.shape[0], time_steps, 1))

model = Sequential()
model.add(LSTM(50, activation='relu', input_shape=(time_steps, 1)))
model.add(Dropout(0.2))
model.add(Dense(50, activation='relu'))  # Fully connected layer (ANN)
model.add(Dropout(0.2))
model.add(Dense(1))  # Output layer
model.compile(optimizer='adam', loss='mse')

model.fit(X_train, y_train, epochs=150)

y_pred = model.predict(X_test)

if np.isnan(y_pred).any() or np.isnan(y_test).any():
    print("Warning: Predictions or test labels contain NaN values. Evaluation may not be accurate.")
else:
    mse = mean_squared_error(y_test[-len(y_pred):], y_pred)
    mae = mean_absolute_error(y_test[-len(y_pred):], y_pred)
    rmse = np.sqrt(mse)
    r2 = r2_score(y_test[-len(y_pred):], y_pred)

    print(f'Mean Squared Error (MSE): {mse}')
    print(f'Mean Absolute Error (MAE): {mae}')
    print(f'Root Mean Squared Error (RMSE): {rmse}')
    print(f'R² Score: {r2}')

    plt.scatter(df['WindSpeed'][-len(y_pred):], y_pred.flatten(), color='orange', label='Predicted')
    plt.scatter(df['WindSpeed'], df['Power_Output'], color='blue', label='Actual')
    plt.xlabel('Wind Speed')
    plt.ylabel('Power Output')
    plt.title('LSTM + ANN Model: Wind Speed vs Power Output')
    plt.legend()
    plt.show()
