# 6c. Combine LSTM with RNN
y_combined_rnn = (y_pred_lstm.flatten() + y_pred_rnn.flatten()) / 2

# 6d. Combine LSTM with Random Forest
y_combined_rf = (y_pred_lstm.flatten() + y_pred_rf) / 2

