from sklearn.ensemble import RandomForestRegressor
from tensorflow.keras.layers import SimpleRNN

# 4a. Define and Train RNN Model
def create_rnn_model(input_shape):
    model = Sequential()
    model.add(SimpleRNN(50, return_sequences=True, input_shape=input_shape))
    model.add(Dropout(0.2))
    model.add(SimpleRNN(50))
    model.add(Dropout(0.2))
    model.add(Dense(1))  # Output layer
    model.compile(optimizer='adam', loss='mean_squared_error')
    return model

rnn_model = create_rnn_model((X_train.shape[1], 1))
rnn_model.fit(X_train, y_train, epochs=50, batch_size=32)

# Make predictions with RNN
y_pred_rnn = rnn_model.predict(X_test)

# 4b. Define and Train Random Forest Model
rf_model = RandomForestRegressor(n_estimators=100, random_state=42)
rf_model.fit(X_train.reshape(X_train.shape[0], -1), y_train)

# Make predictions with Random Forest
y_pred_rf = rf_model.predict(X_test.reshape(X_test.shape[0], -1))

# 6a. Combine LSTM with ANN
